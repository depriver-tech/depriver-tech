---
import ThemePicker from "./ThemePicker.astro";
const path = Astro.url.pathname;
const links = [
  { href: "/#posts", label: "Writing", match: (p: string) => p === "/" || p.startsWith("/blog") },
  { href: "/guides/", label: "Guides", match: (p: string) => p.startsWith("/guides") },
  { href: "/docs/", label: "Resources", match: (p: string) => p.startsWith("/docs") },
  { href: "/talks/", label: "Talks", match: (p: string) => p.startsWith("/talks") },
  { href: "/about/", label: "About", match: (p: string) => p.startsWith("/about") },
];
---
<header class="nav" data-nav>
  <div class="wrap nav-in">
    <a href="/" class="brand" aria-label="Privatus Cosmas, home">
      <span class="brand-name">Privatus <span>Cosmas</span></span>
    </a>
    <nav aria-label="Main" class="links" id="main-navigation">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.match(path) ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="right">
      <ThemePicker />
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-navigation" data-menu-toggle><span></span><span></span></button>
      <a class="cta" href="https://wa.me/255752747681" target="_blank" rel="noopener" title="Let's talk on WhatsApp">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"/></svg>
        <span>Let's talk</span>
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  if (header && toggle) {
    header.classList.add("nav-menu-ready");
    const close = () => {
      header.classList.remove("menu-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open navigation");
    };
    toggle.addEventListener("click", () => {
      const open = !header.classList.contains("menu-open");
      header.classList.toggle("menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      if (open) header.querySelector<HTMLAnchorElement>(".links a")?.focus();
    });
    header.querySelectorAll(".links a").forEach((link) => link.addEventListener("click", close));
    document.addEventListener("click", (event) => { if (!header.contains(event.target as Node)) close(); });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.classList.contains("menu-open")) { close(); toggle.focus(); }
    });
    matchMedia("(min-width: 901px)").addEventListener("change", close);
  }
</script>

<style>
  .nav { position:fixed; z-index:50; top:18px; left:0; right:0; padding-inline:20px; transition:transform .55s var(--ease); }
  .nav.hidden:not(.menu-open) { transform:translateY(calc(-100% - 28px)); }
  .nav-in { position:relative; display:flex; align-items:center; gap:24px; width:min(1180px,100%); min-height:76px; padding:12px 15px 12px 18px; border-radius:24px; background:color-mix(in srgb,var(--surface) 83%,transparent); border:1px solid color-mix(in srgb,var(--heading) 12%,transparent); backdrop-filter:blur(25px) saturate(1.35); -webkit-backdrop-filter:blur(25px) saturate(1.35); box-shadow:inset 0 1px 0 color-mix(in srgb,var(--neu-hi) 65%,transparent), 0 18px 48px -22px color-mix(in srgb,var(--shadow) 45%,transparent); transition:background .4s,min-height .4s; }
  .nav-in::before { content:""; position:absolute; top:-1px; left:15%; right:15%; height:1px; background:linear-gradient(90deg,transparent,var(--accent),transparent); opacity:.5; }
  .brand { display:flex; gap:10px; align-items:center; text-decoration:none; color:var(--heading); margin-right:auto; flex-shrink:0; }
  .brand-name { font-size:1.1rem;font-weight:600;letter-spacing:-.045em;white-space:nowrap; }
  .brand-name > span { font-weight:400;color:var(--muted); }
  .links ul { display:flex; align-items:center; list-style:none; padding:5px; margin:0; border-radius:16px; background:color-mix(in srgb,var(--heading) 4%,transparent); box-shadow:inset 2px 2px 5px color-mix(in srgb,var(--neu-lo) 50%,transparent),inset -2px -2px 5px color-mix(in srgb,var(--neu-hi) 35%,transparent); }
  .links a { display:block; position:relative; padding:10px 15px; text-decoration:none; font-size:.76rem; font-weight:500; color:var(--muted); border-radius:12px; transition:color .3s,background .3s,box-shadow .3s,transform .3s; }
  .links a:hover { color:var(--heading); transform:translateY(-2px); }
  .links a[aria-current] { background:var(--surface); color:var(--heading); box-shadow:3px 3px 8px color-mix(in srgb,var(--shadow) 13%,transparent),inset 0 1px 0 var(--neu-hi); }
  .links a[aria-current]::after { content:""; position:absolute; width:4px;height:4px;border-radius:50%;background:var(--accent);bottom:3px;left:calc(50% - 2px); }
  .right { display:flex; align-items:center; gap:10px; margin-left:auto; }
  .cta { display:inline-flex; align-items:center; gap:8px; background:var(--accent);color:var(--on-accent);border-radius:15px;min-height:44px;padding:0 17px;font-size:.75rem;font-weight:600;text-decoration:none;box-shadow:inset 0 1px 0 #ffffff40,0 7px 20px -10px var(--accent);transition:transform .3s;white-space:nowrap; }
  .cta:hover { transform:translateY(-2px); }
  .right :global(.tp-btn) { border-radius:14px; box-shadow:inset 2px 2px 5px color-mix(in srgb,var(--neu-lo) 65%,transparent),inset -2px -2px 5px color-mix(in srgb,var(--neu-hi) 60%,transparent); }
  .menu-toggle { display:none; width:44px;height:44px;border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--heading);cursor:pointer;align-items:center;justify-content:center;flex-direction:column;gap:5px; }
  .menu-toggle span { width:17px;height:2px;background:currentColor;border-radius:2px;transition:transform .3s; }
  @media(max-width:1100px) { .nav-in { gap:12px; } .links a {padding:10px 11px;} }
  @media(max-width:900px) {
    .nav { top:12px;padding-inline:14px; }
    .nav-in { min-height:68px; padding:10px 12px; gap:12px; border-radius:22px; flex-wrap:wrap; }
    .brand-name {font-size:1rem;}
    .menu-toggle {display:flex;}
    .right {gap:8px;}
    .cta {display:none;}
    .links {width:100%;order:3;}
    .links ul {display:grid;grid-template-columns:1fr 1fr;padding:8px;gap:4px;}
    .links a {padding:13px 15px;font-size:.9rem;}
    .links a[aria-current]::after {left:auto;right:12px;bottom:calc(50% - 2px);}
    .nav-menu-ready:not(.menu-open) .links {display:none;}
    .menu-open .nav-in {background:var(--surface);}
    .menu-open .links {animation:menu-reveal .35s var(--ease);}
    .menu-open .menu-toggle span:first-child {transform:translateY(3.5px) rotate(45deg);}
    .menu-open .menu-toggle span:last-child {transform:translateY(-3.5px) rotate(-45deg);}
  }
  @keyframes menu-reveal {from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
  @media(prefers-reduced-motion:reduce) {*,*::after{animation:none!important;transition:none!important;}}
</style>
