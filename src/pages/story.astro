  .ch.phone { grid-column: span 4; }
  .ch.mail { grid-column: span 6; }
  .ch.wa { --c: #25d366; } .ch.phone { --c: #febc2e; } .ch.mail { --c: #ff8a65; } .ch.in { --c: #4c9ee8; } .ch.ig { --c: #e1306c; } .ch.gh { --c: #c9d1d9; }
  .ch a { display: flex; align-items: center; gap: 14px; height: 100%; padding: 14px 16px; border-radius: 18px; text-decoration: none; background: color-mix(in srgb, var(--on-deep) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--on-deep) 8%, transparent); transition: background 0.35s, border-color 0.35s, transform 0.45s var(--ease); }
  .ch a:hover { background: color-mix(in srgb, var(--c) 16%, transparent); border-color: color-mix(in srgb, var(--c) 50%, transparent); transform: translateY(-3px); }
  .ch-ico { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 13px; color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); transition: transform 0.5s cubic-bezier(.3, 1.6, .5, 1), background 0.3s, color 0.3s; }
  .ch-ico svg { width: 22px; height: 22px; }
  .ch a:hover .ch-ico { transform: rotate(-10deg) scale(1.1); background: var(--c); color: var(--deep); }
  .ch-txt { display: grid; min-width: 0; }
  .ch-txt em { font-style: normal; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--deep-text); }
  .ch-txt strong { color: var(--on-deep); font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .copy { position: absolute; right: 10px; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 10px; cursor: pointer; color: var(--deep-text); background: transparent; transition: background 0.25s, color 0.25s; }
  .copy:hover { background: color-mix(in srgb, var(--on-deep) 10%, transparent); color: var(--on-deep); }
  .copy svg { width: 18px; height: 18px; }
  .copied { position: absolute; bottom: calc(100% + 6px); right: 0; padding: 4px 10px; border-radius: 8px; font-size: 0.75rem; font-weight: 600; white-space: nowrap; background: var(--accent); color: var(--on-accent); opacity: 0; translate: 0 6px; transition: opacity 0.25s, translate 0.3s; pointer-events: none; }
  .copy.done .copied { opacity: 1; translate: 0 0; }
  .ch:has(.copy) a { padding-right: 52px; }
  .ch.in a, .ch.ig a, .ch.gh a { flex-direction: column; align-items: flex-start; gap: 10px; }
  @media (max-width: 760px) {
    .ch.wa, .ch.phone { grid-column: span 6; }
    .ch.in .ch-txt strong, .ch.ig .ch-txt strong, .ch.gh .ch-txt strong { font-size: 0.82rem; }
    .ch.in a, .ch.ig a, .ch.gh a { padding: 12px; }
  }

  .chat { border-radius: 28px; overflow: hidden; background: color-mix(in srgb, #000 22%, var(--deep)); border: 1px solid color-mix(in srgb, var(--on-deep) 10%, transparent); box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7); }
  .chat-head { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid color-mix(in srgb, var(--on-deep) 10%, transparent); }
  .chat-head img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: top; background: var(--surface); box-shadow: 0 0 0 2px var(--accent); filter: var(--photo-filter); }
  .chat-head strong { display: block; color: var(--on-deep); font-size: 0.95rem; }
  .chat-head em { font-style: normal; font-size: 0.8rem; color: #28c840; }
  .chat-body { display: grid; justify-items: start; gap: 8px; padding: 18px; }
  .bubble { max-width: 85%; margin: 0; padding: 10px 14px; border-radius: 18px 18px 18px 6px; background: color-mix(in srgb, var(--on-deep) 10%, transparent); color: var(--on-deep); font-size: 0.98rem; line-height: 1.45;
    opacity: 0; transform: translateY(10px) scale(0.96); transform-origin: left bottom; animation: bubble 0.5s var(--ease) forwards; animation-play-state: paused; }
  .bubble + .bubble { animation-delay: 0.9s; }
  .typing { display: flex; gap: 4px; margin: 0; padding: 12px 14px; border-radius: 18px; background: color-mix(in srgb, var(--on-deep) 10%, transparent); opacity: 0; animation: typing 2.4s 1.8s forwards; animation-play-state: paused; }
  .typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--deep-text); animation: dot 1s infinite; }
  .typing i:nth-child(2) { animation-delay: 0.15s; } .typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes bubble { to { opacity: 1; transform: none; } }
  @keyframes typing { 0%, 70% { opacity: 1; } 100% { opacity: 0; height: 0; padding: 0; } }
  @keyframes dot { 50% { transform: translateY(-4px); opacity: 0.5; } }
  .contact-card.talk .bubble, .contact-card.talk .typing { animation-play-state: running; }
