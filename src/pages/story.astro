---
import { livePosts } from "../lib/posts";
import Base from "../layouts/Base.astro";
import Title from "../components/Title.astro";
import ContactForm from "../components/ContactForm.astro";
import PostCard from "../components/PostCard.astro";
import hero from "../data/hero-lines.json";
import { chapters, lessons, services, outside, dreams, gratitude, contact } from "../data/story";

const posts = (await livePosts()).slice(0, 3);
const age = new Date().getFullYear() - 2006 - (new Date() < new Date(new Date().getFullYear(), 7, 14) ? 1 : 0);
const pad = (n: number) => String(n).padStart(2, "0");
// channel icons for the contact card (stroke paths, 24×24)
const ICONS: Record<string, string> = {"wa": "<path d=\"M3.5 20.5 5 16a8.5 8.5 0 1 1 3.2 3.1Z\"/><path d=\"M9 9.5c.3 2.4 2.2 4.5 4.9 5.2l1.3-1.3 2 1-.4 1.6c-3.7.4-8.4-3.6-8.6-7.6L9.9 8l1 2Z\"/>", "phone": "<path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2\"/>", "mail": "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/>", "in": "<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"/><path d=\"M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7\"/>", "ig": "<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M17.5 6.5v.01\"/>", "gh": "<path d=\"M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21\"/>"};
const places = ["Kitwe", "Nyerere Primary", "Katoke Seminary", "Kaisho Secondary", "MUST", "Mbeya", "Software Engineer", "Digital Innovator"];
---
<Base jsonLd={{ "@context": "https://schema.org", "@type": "ProfilePage", url: "https://depriver.tech/story/", name: "About Privatus Cosmas (Priver)", mainEntity: { "@id": "https://depriver.tech/#person" } }} title="About Privatus Cosmas (Priver) | Software Engineer" image="/og/story.jpg" imageAlt="From Kitwe Village to Writing Code: the story of Privatus Cosmas" description="Meet Privatus Cosmas, also known as Priver: a software engineer in Mbeya, Tanzania. Read his journey from Kitwe, education and approach to building software.">
  <!-- ── HERO ─────────────────────────────────────────── -->
  <section class="hero" data-hero>
    <svg class="contours" viewBox={`0 0 ${hero.w} ${hero.h}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {hero.paths.map((p) => <path d={p.d} class:list={{ major: p.major }} />)}
    </svg>
    <div class="hero-block" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="kicker" data-reveal>I’m Privatus Cosmas, also known as Priver. This is my story.</p>
        <h1 class="display hero-title">
          <span class="line-mask"><span>From Kitwe</span></span>
          <span class="line-mask accent"><span>Village to</span></span>
          <span class="line-mask"><span>Writing <span class="cw" aria-label="Code"><b aria-hidden="true">&lt;</b>Code<b aria-hidden="true">/&gt;</b></span></span></span>
        </h1>
        <p class="lead" data-reveal>
          The setbacks, the second chances and everything in between that made me a{" "}
          <strong>Software Engineer & Digital Innovator</strong>.
        </p>
        <div class="hero-actions" data-reveal>
          <a class="btn" href="#story">Read my story
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          </a>
          <a class="btn ghost" href="/">Visit the blog</a>
        </div>
      </div>
      <figure class="hero-photo">
        <img src="/img/me-cut.webp" srcset="/img/me-cut-540.webp 540w, /img/me-cut.webp 900w" sizes="(max-width: 760px) 100vw, 46vw" alt="Portrait of Privatus Cosmas" width="900" height="1200" fetchpriority="high" />
      </figure>
      {/* a tiny terminal next to the portrait types who I am */}
      <div class="hero-term" aria-hidden="true" data-hterm>
        <p class="ht-bar"><span class="dots"><i></i><i></i><i></i></span>zsh</p>
        <p><span class="pr">$</span> <span data-type="whoami"></span></p>
        <p class="out" data-type="privatus · software engineer"></p>
        <p><span class="pr">$</span> <span data-type="route --from kitwe --to mbeya"></span></p>
        <p class="out" data-type="2006 → today · 10 chapters · still going"></p>
        <p><span class="pr">$</span> <span class="hcaret"></span></p>
      </div>
      <p class="hero-name script" aria-hidden="true">Privatus <span>Cosmas</span></p>
    </div>
  </section>

  <script>
    // type the hero terminal one line at a time, after the intro animation
    const term = document.querySelector<HTMLElement>("[data-hterm]");
    if (term) {
      const lines = [...term.querySelectorAll<HTMLElement>("[data-type]")];
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) lines.forEach((l) => (l.textContent = l.dataset.type!));
      else {
        const caret = term.querySelector<HTMLElement>(".hcaret")!;
        caret.style.visibility = "hidden";
        const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
        (async () => {
          await wait(1800);
          for (const l of lines) {
            const text = l.dataset.type!, out = l.classList.contains("out");
            if (out) { l.textContent = text; await wait(450); continue; }
            for (let i = 1; i <= text.length; i++) { l.textContent = text.slice(0, i); await wait(55 + Math.random() * 50); }
            await wait(300);
          }
          caret.style.visibility = "";
        })();
      }
    }
  </script>

  <!-- ── MARQUEE ──────────────────────────────────────── -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => places.map((p) => <span>{p}<i></i></span>))}
    </div>
  </div>

  <!-- ── PROLOGUE ─────────────────────────────────────── -->
  <section class="prologue wrap">
    <span class="label" data-reveal>Prologue</span>
    <p class="big" data-reveal>
      I'm a village boy from Kagera who once couldn't follow a lesson in English.
      I've been sent back to the bottom of the class, robbed of everything I owned and
      pushed to the edge of dropping out. <em>Every time, I started again.</em>
    </p>
    <div class="stats">
      <a href="#born" data-reveal><strong><span data-count={age}>{age}</span></strong><span class="k">Years of story</span><span class="d">2006 to today, Kitwe to Mbeya</span><i aria-hidden="true">↓</i></a>
      <a href="#graduation" data-reveal><strong><span data-count="2">2</span><small>×</small></strong><span class="k">Division I results</span><span class="d">Form Two, then Form Four</span><i aria-hidden="true">↓</i></a>
      <a href="#story" data-reveal><strong><span data-count={chapters.length}>{chapters.length}</span></strong><span class="k">Chapters below</span><span class="d">The falls, and every start again</span><i aria-hidden="true">↓</i></a>
    </div>
  </section>

  <!-- ── STORY ────────────────────────────────────────── -->
  <section id="story" class="story wrap">
    <nav class="rail" aria-label="Chapters">
      <div class="rail-in">
        <span class="label">The story</span>
        <p class="rail-year" data-rail-year>{chapters[0].year}</p>
        <p class="rail-place" data-rail-place>{chapters[0].place}</p>
        <div class="stops">
          <span class="stops-line" aria-hidden="true"><span data-rail-line></span></span>
          <ol>
            {chapters.map((c, i) => (
              <li><a href={`#${c.id}`} data-stop={c.id} class:list={{ on: i === 0 }}><span class="dot" aria-hidden="true"></span><span class="n">{pad(i + 1)}</span><span class="t">{c.title} {c.accent}</span></a></li>
            ))}
          </ol>
        </div>
      </div>
    </nav>
    {/* phones: a small chip keeps your place in the story */}
    <div class="ch-chip" data-ch-chip aria-hidden="true">
      <span class="chip-n" data-chip-n>01</span>
      <span class="chip-t" data-chip-t>{chapters[0].year} · {chapters[0].title} {chapters[0].accent}</span>
      <i><b data-chip-bar></b></i>
    </div>

    <div class="chapters">
      {chapters.map((c, i) => (
        <article class:list={["chapter", { dark: c.tone === "dark" }]} data-chapter={c.year} data-place={c.place} data-name={`${c.title} ${c.accent}`} data-n={pad(i + 1)} id={c.id}>
          {c.tone === "dark" && <div class="dark-bg deep" aria-hidden="true"></div>}
          <div class="ch-head">
            <span class="ch-num" data-drift>{pad(i + 1)}</span>
            <p class="ch-meta" data-reveal>
              <span class="ch-year-inline">{c.year}</span>
              <span>{c.when}</span>
              <span class="pin">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
                {c.place}
              </span>
            </p>
            <Title title={c.title} accent={c.accent} light={c.tone === "dark"} />
          </div>

          <div class:list={["ch-body", { split: c.feature === "rank" || c.feature === "robbed" }]}>
            <div class="ch-text">
              {c.body.map((p) => <p data-reveal>{p}</p>)}
            </div>

            {c.feature === "rank" && (
              <div class="rank card" data-rank data-reveal>
                <p class="card-label">Class position, 2021</p>
                <div class="rank-meter">
                  <div class="rank-bar"><span class="rank-fill"></span><span class="rank-dot"></span></div>
                  <div class="rank-labels">
                    <div><strong>2nd</strong><span>in class · <b data-count="78">78</b>% average</span></div>
                    <div><strong>2nd from last</strong><span>first-semester break</span></div>
                  </div>
                </div>
              </div>
            )}

            {c.feature === "robbed" && (
              <div class="lost card" data-reveal>
                <p class="card-label">Gone in one night</p>
                <ul>
                  {["Laptop", "Phone", "Sony FX3 camera", "All my certificates"].map((x) => <li><s>{x}</s></li>)}
                </ul>
                <p class="kept"><span>What I kept</span>My skills, and a family standing behind me.</p>
              </div>
            )}
          </div>

          {c.feature === "results" && (
            <div class="tty" data-tty>
              <div class="tty-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span>necta — results</span></div>
              <div class="tty-body">
                <p class="tl"><span class="prompt">$</span> necta results --candidate "Privatus Cosmas"</p>
                <p class="tl dim">Fetching results… done</p>
                {[
                  { exam: "Form Two · FTNA", where: "Katoke Seminary · 2020", pts: 11, note: "sat it straight after hospital" },
                  { exam: "Form Four · CSEE", where: "Kaisho Secondary · 2022", pts: 7, note: "the best score possible", best: true },
                ].map((r) => (
                  <div class:list={["tl", "res", { best: r.best }]}>
                    <div class="res-exam"><strong>{r.exam}</strong><span>{r.where}</span></div>
                    <span class="res-div">Division I</span>
                    <div class="res-pts">
                      <strong>{r.pts}<small> pts</small></strong>
                      <span class="meter" style={`--f:${(17 - r.pts) / 10}`}><i></i></span>
                      <span class="res-note">{r.best ? "★ " : ""}{r.note}</span>
                    </div>
                  </div>
                ))}
                <p class="tl ok">✓ fewer points is better: 11 → 7</p>
                <p class="tl"><span class="prompt">$</span> <span class="caret-t" aria-hidden="true"></span></p>
              </div>
            </div>
          )}

          {c.quote && <p class="quote script" data-reveal>“{c.quote}”</p>}

          {c.feature === "memory" && (
            <div class="memory" data-reveal>
              <svg class="candle" viewBox="0 0 60 90" aria-hidden="true" data-draw>
                <path d="M30 8c6 9 8 14 8 19a8 8 0 0 1-16 0c0-5 2-10 8-19Z" fill="none" stroke="#e8603a" stroke-width="2.5" />
                <path d="M18 44h24v40H18z" fill="none" stroke="#a9c4f5" stroke-width="2.5" />
              </svg>
              <div>
                <p class="memory-label">In loving memory of Dad</p>
                <p class="script memory-name">Patrick</p>
              </div>
            </div>
          )}

          {c.facts && (
            <dl class="facts">
              {c.facts.map((f) => <div data-reveal><dt>{f.value}</dt><dd>{f.label}</dd></div>)}
            </dl>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- ── LESSONS ──────────────────────────────────────── -->
  <section class="lessons wrap">
    <header class="sh">
      <div>
        <span class="label" data-reveal>What it taught me</span>
        <Title title="Three lessons" accent="I carry everywhere" size="clamp(2rem, 3.6vw, 3.1rem)" />
      </div>
      <p class="sh-lead" data-reveal>Every chapter left me something. These three I use every single day.</p>
    </header>
    <ol class="lesson-list">
      {lessons.map((l) => { const i = chapters.findIndex((c) => c.id === l.from); return (
        <li class="lesson" data-lesson>
          <div class="lesson-top">
            <span class="lesson-n" aria-hidden="true">{l.n}</span>
            {i >= 0 && <a class="lesson-from" href={`#${l.from}`}>Ch. {pad(i + 1)} · {chapters[i].year}<span aria-hidden="true">↑</span></a>}
          </div>
          <h3>{l.title}</h3>
          <p>{l.body}</p>
          <div class="diff" aria-label={`Then: ${l.then}. Now: ${l.now}.`}>
            <p class="diff-cmd"><span>$</span> git diff then..now</p>
            <p class="del">- {l.then}</p>
            <p class="add">+ {l.now}</p>
          </div>
        </li>
      ); })}
    </ol>
    <script>
      // each lesson's diff prints when it scrolls in
      const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))), { threshold: 0.4 });
      document.querySelectorAll("[data-lesson]").forEach((el) => io.observe(el));
    </script>
  </section>

  <!-- ── TODAY ────────────────────────────────────────── -->
  <section id="today" class="today deep">
    <div class="wrap">
      <header class="sh">
        <div>
          <span class="label" data-reveal>Chapter {pad(chapters.length + 1)} · Today</span>
          <Title title="Software Engineer" accent="& Digital Innovator" light size="clamp(2rem, 3.6vw, 3.1rem)" />
        </div>
        <p class="sh-lead today-lead" data-reveal>
          Today I build software full time in Mbeya: web and mobile apps, business systems and data tools,
          with real exposure to every part of tech.
        </p>
      </header>
      {/* what I do today, as my editor: each service is a file, life beyond code is the terminal */}
      <div class="ide" data-ide data-reveal>
        <div class="ide-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="ide-path">~/privatus/today</span>
          <span class="ide-live"><i></i>Building in Mbeya</span>
        </div>
        <div class="ide-body">
          <div class="explorer" role="tablist" aria-label="What I do">
            <p class="ex-head">Explorer</p>
            {services.map((s, i) => (
              <button type="button" role="tab" class:list={["file", { on: i === 0 }]} aria-selected={i === 0 ? "true" : "false"} aria-controls={`svc-${i}`} data-file>
                <span class:list={["ext", s.file.split(".").pop()]}>{s.file.split(".").pop()}</span>{s.file}
              </button>
            ))}
          </div>
          <div class="editor">
            {services.map((s, i) => (
              <div class:list={["pane", { on: i === 0 }]} id={`svc-${i}`} role="tabpanel" data-pane>
                <p class="pane-tab">{s.file}<span aria-hidden="true">×</span></p>
                <ol class="code">
                  <li><span class="t-c">{s.file.endsWith(".sql") ? "--" : s.file.endsWith(".md") || s.file.endsWith(".json") ? "" : "//"} {pad(i + 1)} · {s.title}</span></li>
                  <li><span class="t-c">{s.file.endsWith(".sql") ? "--" : s.file.endsWith(".md") || s.file.endsWith(".json") ? "" : "//"} {s.body}</span></li>
                  <li></li>
                  {s.code.map((line) => <li set:html={line.replace(/<(\/?)(k|f|s|p|n|c)>/g, (_, end, t) => (end ? "</span>" : `<span class="t-${t}">`))} />)}
                </ol>
              </div>
            ))}
          </div>
        </div>
        <div class="term">
          <p class="term-head">Terminal</p>
          <p class="cmd"><span class="prompt">privatus@mbeya:~$</span> ls life-beyond-code/</p>
          <ul class="ls">{outside.map((o) => <li>{o.toLowerCase().replace(/ & /g, "-and-").replace(/\s+/g, "-")}/</li>)}</ul>
          <p class="cmd"><span class="prompt">privatus@mbeya:~$</span> <span class="caret-t" aria-hidden="true"></span></p>
        </div>
      </div>
    </div>
    <script>
      // pick a file to open it; while you're not touching it, the editor walks through the files by itself
      const ide = document.querySelector<HTMLElement>("[data-ide]");
      if (ide) {
        const files = [...ide.querySelectorAll<HTMLButtonElement>("[data-file]")];
        const panes = [...ide.querySelectorAll<HTMLElement>("[data-pane]")];
        let cur = 0, timer = 0, held = false, seen = false;
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const open = (i: number) => {
          cur = (i + files.length) % files.length;
          files.forEach((f, n) => { f.classList.toggle("on", n === cur); f.setAttribute("aria-selected", String(n === cur)); });
          panes.forEach((p, n) => p.classList.toggle("on", n === cur));
          const bar = files[cur].parentElement!;
          if (bar.scrollWidth > bar.clientWidth) bar.scrollTo({ left: files[cur].offsetLeft - 10, behavior: "smooth" });
        };
        const tick = () => { clearInterval(timer); if (!calm && seen && !held) timer = window.setInterval(() => open(cur + 1), 5000); };
        files.forEach((f, n) => f.addEventListener("click", () => { open(n); held = true; tick(); }));
        ide.addEventListener("pointerenter", () => { held = true; tick(); });
        ide.addEventListener("pointerleave", () => { held = false; tick(); });
        new IntersectionObserver(([e]) => { seen = e.isIntersecting; tick(); }, { threshold: 0.4 }).observe(ide);
      }
    </script>
  </section>

  <!-- ── NEXT CHAPTER ─────────────────────────────────── -->
  <section id="next" class="next wrap">
    <header class="sh">
      <div>
        <span class="label" data-reveal>Chapter {pad(chapters.length + 2)} · What's next</span>
        <Title title="The next" accent="chapter" size="clamp(2rem, 3.6vw, 3.1rem)" />
      </div>
      <p class="sh-lead" data-reveal>Where I'm going from here. These are the goals I wake up for.</p>
    </header>
    {/* the road ahead: the story's line keeps going, with a stop for each kind of dream */}
    <div class="road" data-road>
      <div class="road-ends" aria-hidden="true">
        <span class="here"><i></i>You are here · {new Date().getFullYear()}</span>
        <span class="far">and beyond →</span>
      </div>
      <div class="dream-grid">
      <div class="road-line" aria-hidden="true"><span></span></div>
      {dreams.map((d, i) => (
        <div class:list={["dream", { hot: i === 1 }]} style={`--i:${i}`}>
          <span class="dream-icon" aria-hidden="true">
            {d.icon === "heart" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></svg>}
            {d.icon === "rocket" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15c-1.5 1.3-2 4-2 6 2 0 4.7-.5 6-2m-4-4 4 4m-4-4c1-4 4.5-9.5 12-12 0 7.5-5.5 11-9.5 12.5L5 15Zm10-6h.01"/></svg>}
            {d.icon === "road" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 21 9 3m9 18L15 3M12 5v2m0 4v2m0 4v2"/></svg>}
          </span>
          <p class="dream-count">{d.items.length} goals</p>
          <h3>{d.group}</h3>
          <ul>{d.items.map((t, n) => <li style={`--n:${n}`}>{t}</li>)}</ul>
        </div>
      ))}
      </div>
    </div>
    <p class="tbc script" data-reveal>To be continued<span class="caret" aria-hidden="true"></span></p>
    <script>
      // the road draws itself, then each stop and its goals arrive in turn
      const road = document.querySelector("[data-road]");
      if (road) {
        const io = new IntersectionObserver(([e]) => e.isIntersecting && (road.classList.add("in"), io.disconnect()), { threshold: 0.25 });
        io.observe(road);
      }
    </script>
  </section>

  <!-- ── THANKS ───────────────────────────────────────── -->
  <section id="gratitude" class="thanks wrap">
    <header class="sh">
      <div>
        <span class="label" data-reveal>Gratitude</span>
        <Title title="The people" accent="who carried me" size="clamp(2rem, 3.6vw, 3.1rem)" />
      </div>
      <p class="sh-lead" data-reveal>No story like this is written alone. Some held my hand directly, others helped from a distance. Every one of them is part of this.</p>
    </header>

    {/* one card, drawn as a tree: the closest people are the leaves, I'm the trunk, everyone along the way is the roots */}
    <article class="thanks-card" data-reveal>
      <div class="tree" data-tree>
        <svg class="limbs" aria-hidden="true" data-limbs></svg>
        <ul class="crown">
          {gratitude.people.map((p) => {
            const initials = p.name.split(/\s*&\s*|\s+/).map((w) => w[0]).slice(0, 2).join("");
            return (
              <li class:list={["leaf", { "in-memory": p.memory }]} data-leaf>
                <span class="av" aria-hidden="true">
                  {p.photo ? <img src={p.photo} alt="" loading="lazy" /> : <span class="script">{initials}</span>}
                </span>
                <div>
