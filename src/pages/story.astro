  .chapter.dark .pin { background: color-mix(in srgb, var(--accent-2) 14%, transparent); color: var(--on-deep); }
  .memory { display: flex; align-items: center; gap: 22px; margin-top: 36px; padding-top: 30px; border-top: 1px solid color-mix(in srgb, var(--accent-2) 20%, transparent); }
  .candle { width: 46px; height: 70px; flex: none; }
  .memory-label { margin: 0; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--accent-2); }
  .memory-name { margin: 0; color: var(--on-deep); font-size: 3.4rem; line-height: 1; }

  /* LESSONS */

  /* TODAY */
  .today { background: var(--deep); color: var(--deep-text); padding: 88px 0; }
  .today :global(.display) { margin-top: 22px; }
  .today-lead { font-size: 1.25rem; max-width: 38em; margin: 30px 0 56px; }
  .ide { --mono: ui-monospace, "JetBrains Mono", "Fira Code", Menlo, Consolas, monospace; border-radius: 22px; overflow: hidden; background: color-mix(in srgb, #000 30%, var(--deep));
    border: 1px solid color-mix(in srgb, var(--accent-2) 18%, transparent); box-shadow: 0 50px 100px -50px rgb(0 0 0 / 0.8); }
  .ide-bar { display: flex; align-items: center; gap: 16px; padding: 12px 18px; background: color-mix(in srgb, var(--accent-2) 8%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--accent-2) 14%, transparent); font-size: 0.82rem; }
  .dots { display: flex; gap: 7px; }
  .dots i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }
  .ide-path { font-family: var(--mono); color: var(--deep-text); }
  .ide-live { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--on-deep); }
  .ide-live i { width: 8px; height: 8px; border-radius: 50%; background: #28c840; box-shadow: 0 0 0 0 #28c840; animation: live 2s infinite; }
  @keyframes live { 70% { box-shadow: 0 0 0 8px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .ide-body { display: grid; grid-template-columns: 250px minmax(0, 1fr); min-height: 330px; }
  .explorer { padding: 14px 10px; border-right: 1px solid color-mix(in srgb, var(--accent-2) 12%, transparent); display: grid; align-content: start; gap: 2px; }
  .ex-head, .term-head { margin: 0 0 8px 10px; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: color-mix(in srgb, var(--deep-text) 70%, transparent); }
  .file { display: flex; align-items: center; gap: 10px; width: 100%; padding: 9px 10px; border: 0; border-radius: 10px; background: none; font: 500 0.9rem var(--mono); color: var(--deep-text); text-align: left; cursor: pointer; transition: background 0.25s, color 0.25s; }
  .file:hover { background: color-mix(in srgb, var(--accent-2) 8%, transparent); color: var(--on-deep); }
  .file.on { background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--on-deep); }
  .ext { flex: none; min-width: 34px; padding: 2px 0; border-radius: 5px; font-size: 0.62rem; font-weight: 700; text-align: center; text-transform: uppercase; color: #0b1020; background: #7aa2f7; }
  .ext.tsx { background: #61dafb; } .ext.ts { background: #7aa2f7; } .ext.sql { background: #febc2e; } .ext.json { background: #c3e88d; } .ext.md { background: var(--accent); }
  .editor { position: relative; display: grid; }
  .pane { grid-area: 1 / 1; visibility: hidden; }
  .pane.on { visibility: visible; }
  .pane-tab { display: inline-flex; gap: 14px; margin: 0; padding: 10px 18px; font: 500 0.85rem var(--mono); color: var(--on-deep); border-bottom: 2px solid var(--accent); background: color-mix(in srgb, var(--accent-2) 6%, transparent); }
  .pane-tab span { opacity: 0.5; }
  .code { list-style: none; counter-reset: ln; margin: 0; padding: 18px 20px 24px 0; font: 0.95rem/1.75 var(--mono); color: var(--on-deep); overflow-x: auto; }
  .code li { counter-increment: ln; white-space: pre; min-height: 1.75em; }
  .code li::before { content: counter(ln); display: inline-block; width: 3.2em; padding-right: 1.2em; text-align: right; color: color-mix(in srgb, var(--deep-text) 45%, transparent); }
  .pane.on .code li { animation: line 0.45s var(--ease) both; }
  .pane.on .code li:nth-child(2) { animation-delay: 0.06s; } .pane.on .code li:nth-child(3) { animation-delay: 0.12s; } .pane.on .code li:nth-child(4) { animation-delay: 0.18s; }
  .pane.on .code li:nth-child(5) { animation-delay: 0.24s; } .pane.on .code li:nth-child(6) { animation-delay: 0.3s; } .pane.on .code li:nth-child(7) { animation-delay: 0.36s; } .pane.on .code li:nth-child(n + 8) { animation-delay: 0.42s; }
  @keyframes line { from { opacity: 0; transform: translateX(-12px); } }
  .code :global(.t-c) { color: color-mix(in srgb, var(--deep-text) 75%, transparent); font-style: italic; }
  .code :global(.t-k) { color: #c792ea; } .code :global(.t-f) { color: #82aaff; } .code :global(.t-s) { color: #c3e88d; } .code :global(.t-p) { color: #ffcb6b; } .code :global(.t-n) { color: var(--accent); }
  .term { padding: 14px 20px 18px; border-top: 1px solid color-mix(in srgb, var(--accent-2) 14%, transparent); font: 0.9rem/1.7 var(--mono); color: var(--deep-text); }
  .term-head { margin-left: 0; font-family: inherit; }
  .cmd { margin: 0; color: var(--on-deep); }
  .prompt { color: #28c840; }
  .ls { display: flex; flex-wrap: wrap; gap: 4px 26px; list-style: none; margin: 2px 0 6px; padding: 0; }
  .ls li { color: #82aaff; transition: color 0.2s; }
  .ls li:hover { color: var(--accent); }
  .caret-t { display: inline-block; width: 9px; height: 1.1em; vertical-align: -0.2em; background: var(--on-deep); animation: caret 1s steps(1) infinite; }
  @media (prefers-reduced-motion: reduce) { .pane.on .code li, .ide-live i, .caret-t { animation: none; } }
  @media (max-width: 760px) {
    .ide { margin: 0 calc(-1 * var(--gutter) + 8px); border-radius: 18px; }
    .ide-path { display: none; }
    .ide-body { grid-template-columns: 1fr; min-height: 0; }
    .explorer { display: flex; overflow-x: auto; gap: 6px; padding: 10px; border-right: 0; border-bottom: 1px solid color-mix(in srgb, var(--accent-2) 12%, transparent); scrollbar-width: none; }
    .ex-head { display: none; }
    .file { width: auto; flex: none; font-size: 0.8rem; }
    .editor { min-height: 290px; }
    .code { font-size: 0.8rem; }
    .code li::before { width: 2.4em; padding-right: 0.8em; }
    .term { font-size: 0.8rem; }
  }

  /* NEXT CHAPTER */
  .next { padding: 88px 0 40px; }
  .next :global(.display) { margin-top: 22px; }
  .next-lead { font-size: 1.2rem; color: var(--muted); max-width: 34em; margin: 24px 0 48px; }
  .road { position: relative; --stop: 30px; }
  .road-ends { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .here { display: inline-flex; align-items: center; gap: 10px; color: var(--heading); }
  .here i { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 var(--accent); animation: here 2s infinite; }
  @keyframes here { 70% { box-shadow: 0 0 0 12px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .road-line { position: absolute; left: 0; right: 0; top: calc(var(--stop) - 1.5px); height: 3px; border-radius: 2px;
    background: repeating-linear-gradient(90deg, var(--line) 0 14px, transparent 14px 26px); }
  .road-line span { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, var(--accent) 0 14px, transparent 14px 26px); transform: scaleX(0); transform-origin: left; transition: transform 1.8s var(--ease); }
  .road.in .road-line span { transform: scaleX(1); }
  .dream-grid { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: start; }
  .dream { position: relative; padding: 0 28px 30px 0; }
  .dream-icon { position: relative; display: grid; place-items: center; width: calc(var(--stop) * 2); height: calc(var(--stop) * 2); border-radius: 50%; background: var(--bg, var(--surface)); color: var(--accent);
    border: 2px solid var(--accent); transform: scale(0); transition: transform 0.7s cubic-bezier(.3, 1.6, .5, 1), background 0.4s, color 0.4s; transition-delay: calc(0.5s + var(--i) * 0.45s); }
  .dream-icon svg { width: 26px; height: 26px; }
  .dream.hot .dream-icon, .dream:hover .dream-icon { background: var(--accent); color: var(--on-accent); }
  .road.in .dream-icon { transform: scale(1); }
  .dream-count { margin: 22px 0 4px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .dream h3 { margin: 0 0 18px; font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.1; letter-spacing: -0.02em; color: var(--heading); }
  .dream-count, .dream h3 { opacity: 0; transform: translateY(14px); transition: opacity 0.6s, transform 0.7s var(--ease); transition-delay: calc(0.7s + var(--i) * 0.45s); }
  .dream ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .dream li { position: relative; padding: 10px 0 10px 34px; border-top: 1px dashed var(--line); color: var(--text); line-height: 1.45;
    opacity: 0; transform: translateX(-10px); transition: opacity 0.5s, transform 0.6s var(--ease), color 0.3s; transition-delay: calc(0.9s + var(--i) * 0.45s + var(--n) * 0.12s); }
  .dream li::before { content: ""; position: absolute; left: 2px; top: 12px; width: 18px; height: 18px; border-radius: 6px; border: 2px solid color-mix(in srgb, var(--accent) 70%, transparent); transition: background 0.3s; }
  .dream li:hover { color: var(--heading); }
  .dream li:hover::before { background: color-mix(in srgb, var(--accent) 25%, transparent); }
  .road.in .dream-count, .road.in .dream h3, .road.in .dream li { opacity: 1; transform: none; }
  html:not(.js) .dream-icon, html:not(.js) .dream-count, html:not(.js) .dream h3, html:not(.js) .dream li { opacity: 1; transform: none; }
  .tbc { font-size: clamp(2rem, 3.6vw, 2.8rem); color: var(--accent); text-align: right; margin: 18px 0 0; line-height: 1.1; }
  .caret { display: inline-block; width: 3px; height: 0.8em; margin-left: 6px; vertical-align: -0.05em; background: var(--accent); animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  @media (max-width: 760px) {
    .road { padding-left: 0; }
    .road-ends .far { display: none; }
    .here { margin-left: calc(var(--stop) - 5px); }
    .road-line { top: 0; bottom: 0; left: calc(var(--stop) - 1px); right: auto; width: 3px; height: auto;
      background: repeating-linear-gradient(180deg, var(--line) 0 14px, transparent 14px 26px); }
    .road-line span { background: repeating-linear-gradient(180deg, var(--accent) 0 14px, transparent 14px 26px); transform: scaleY(0); transform-origin: top; }
    .road.in .road-line span { transform: scaleY(1); }
    .dream-grid { grid-template-columns: 1fr; gap: 26px; }
    .dream { display: grid; grid-template-columns: calc(var(--stop) * 2) 1fr; column-gap: 18px; padding: 0; }
    .dream > :not(.dream-icon) { grid-column: 2; }
    .dream-icon { grid-row: 1 / span 3; }
    .dream-count { margin-top: 6px; }
  }

  /* THANKS */
  .thanks { padding: 72px 0 32px; }
  .thanks :global(.display) { margin-top: 22px; }
  .thanks-lead { font-size: 1.2rem; color: var(--muted); max-width: 38em; margin: 24px 0 50px; }
  .thanks-sub { margin: 0 0 26px; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }

  /* one card for everyone */
  .thanks-card { border-radius: 30px; padding: clamp(20px, 3vw, 36px); background: var(--surface); overflow: hidden;
    box-shadow: 0 1px 0 var(--line), 0 40px 80px -50px color-mix(in srgb, var(--shadow) 45%, transparent); }


  /* LATEST */
  .latest { padding: 72px 0; }
  .latest-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; }
  .latest-head :global(.display) { margin-top: 22px; }
  .post-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 44px; }

  /* CONTACT */
  .contact { padding: 40px 0 120px; }
  .contact-card { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 56px); align-items: start; background: var(--deep); color: var(--deep-text); border-radius: 40px; padding: clamp(28px, 5vw, 64px); }
  .contact-card h2 { font-size: clamp(2.2rem, 5vw, 3.8rem); margin: 22px 0 14px; color: var(--on-deep); }
  .c-lead { margin: 0 0 18px; font-size: 1.1rem; }
  .clock { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 26px; padding: 8px 16px; border-radius: 999px; font-size: 0.88rem; font-weight: 600; color: var(--on-deep); background: color-mix(in srgb, var(--on-deep) 8%, transparent); }
  .clock i { width: 9px; height: 9px; border-radius: 50%; background: #8a93b0; }
  .clock.awake i { background: #28c840; animation: live 2s infinite; }
  .channels { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  .ch { --c: var(--accent); position: relative; grid-column: span 2; }
