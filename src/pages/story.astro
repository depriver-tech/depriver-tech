  .facts dd { margin: 4px 0 0; color: var(--muted); font-size: 0.92rem; }

  /* the hardest season */
  .chapter.dark { border: 0; padding: 90px clamp(24px, 5vw, 64px); margin: 40px 0; color: var(--deep-text); isolation: isolate; }
  .dark-bg { position: absolute; inset: 0; background: var(--deep); border-radius: 36px; z-index: -1; }
  .chapter.dark .ch-num { -webkit-text-stroke-color: color-mix(in srgb, var(--accent-2) 18%, transparent); z-index: 0; right: 40px; }
  .chapter.dark .ch-text p { color: var(--deep-text); }
