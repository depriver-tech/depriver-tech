  .res-div { padding: 6px 12px; border-radius: 8px; font-family: var(--font, inherit); font-weight: 800; font-size: clamp(1rem, 2vw, 1.35rem); letter-spacing: 0.02em; color: #0b1226; background: #c3e88d; white-space: nowrap; }
