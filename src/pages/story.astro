  html:not(.js) .tl { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .tl { opacity: 1; transform: none; } .tty .meter i { transform: scaleX(var(--f)); } }
  @media (max-width: 640px) {
    .tty { margin-left: calc(-1 * var(--gutter) + 8px); margin-right: calc(-1 * var(--gutter) + 8px); }
    .tty-body { padding: 14px; font-size: 0.8rem; }
    .res { grid-template-columns: 1fr auto; gap: 12px; }
    .res-pts { grid-column: 1 / -1; }
  }
  .quote { font-size: clamp(2.4rem, 5vw, 3.8rem); color: var(--heading); margin: 40px 0 0; line-height: 1.1; }

  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 34px 0 0; }
  .facts div { border-top: 4px solid var(--accent); padding-top: 14px; }
