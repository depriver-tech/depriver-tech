  @media (prefers-reduced-motion: reduce) { .bubble { opacity: 1; transform: none; animation: none; } .typing { display: none; } }

  /* RESPONSIVE */
  @media (max-width: 960px) {
    .story { grid-template-columns: 1fr; gap: 0; }
