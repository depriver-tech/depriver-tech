          <img src="/img/me-cut.webp" alt="" width="64" height="64" loading="lazy" />
          <div><p class="script">Privatus</p><span>grew from all of this</span></div>
        </div>
      </div>

      <div class="side">
        <div class="roots" data-roots>
          <p class="roots-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>~/roots</p>
          <div class="roots-body">
            <p class="roots-cmd"><span>$</span> ls everyone-along-the-way/</p>
            <ul class="roots-ls" role="tablist" aria-label="Everyone along the way">
              {gratitude.groups.map((g, i) => (
                <li><button type="button" role="tab" class:list={{ on: i === 0 }} aria-selected={i === 0 ? "true" : "false"} aria-controls={`root-${i}`} data-root>{g.title.toLowerCase().replace(/['’]/g, "").replace(/\s+/g, "-")}</button></li>
              ))}
            </ul>
            <p class="roots-cmd"><span>$</span> cat <span class="roots-file" data-root-file>{gratitude.groups[0].title.toLowerCase().replace(/['’]/g, "").replace(/\s+/g, "-")}</span></p>
            <div class="roots-out">
              {gratitude.groups.map((g, i) => (
                <p id={`root-${i}`} role="tabpanel" class:list={{ on: i === 0 }} data-root-note><b>{g.title}.</b> {g.note}</p>
              ))}
            </div>
          </div>
        </div>

        <div class="asante deep">
          <p class="script">Asante sana</p>
          <p>To everyone who helped me, named here or not: this story is yours too. And to you, reading this: if it helped you, pass it on.</p>
          <a class="btn pass" href={`https://wa.me/?text=${encodeURIComponent("A story worth reading: from Kitwe village to writing code. https://depriver.tech/story/")}`} target="_blank" rel="noopener">Pass it on
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v13"/></svg>
          </a>
        </div>
      </div>
    </article>
    <script>
      // branches grow from my photo to each person, drawn to fit wherever the cards land
      const tree = document.querySelector<HTMLElement>("[data-tree]");
      if (tree) {
        const svg = tree.querySelector<SVGSVGElement>("[data-limbs]")!;
        const me = tree.querySelector<HTMLElement>("[data-me] img")!;
        const leaves = [...tree.querySelectorAll<HTMLElement>("[data-leaf]")];
        const draw = () => {
          const t = tree.getBoundingClientRect();
          svg.setAttribute("viewBox", `0 0 ${t.width} ${t.height}`);
          const m = me.getBoundingClientRect();
          const mx = m.left + m.width / 2 - t.left, my = m.top - t.top;
          svg.innerHTML = leaves.map((l, i) => {
            const r = l.getBoundingClientRect();
            const x = r.left + r.width / 2 - t.left, y = r.bottom - t.top - 8;
            return `<path pathLength="1" style="--i:${i}" d="M${mx} ${my} C ${mx} ${my - (my - y) * 0.55}, ${x} ${y + (my - y) * 0.45}, ${x} ${y}" />`;
          }).join("");
        };
        new ResizeObserver(draw).observe(tree);
        // the roots terminal: pick a name to cat its file; it walks through them by itself while you read
        const roots = document.querySelector<HTMLElement>("[data-roots]");
        if (roots) {
          const btns = [...roots.querySelectorAll<HTMLButtonElement>("[data-root]")];
          const notes = [...roots.querySelectorAll<HTMLElement>("[data-root-note]")];
          const file = roots.querySelector<HTMLElement>("[data-root-file]")!;
          let cur = 0, timer = 0, held = false, seen = false;
          const show = (i: number) => {
            cur = (i + btns.length) % btns.length;
            btns.forEach((b, n) => { b.classList.toggle("on", n === cur); b.setAttribute("aria-selected", String(n === cur)); });
            notes.forEach((p, n) => p.classList.toggle("on", n === cur));
            file.textContent = btns[cur].textContent;
          };
          const tick = () => { clearInterval(timer); if (seen && !held && !matchMedia("(prefers-reduced-motion: reduce)").matches) timer = window.setInterval(() => show(cur + 1), 4500); };
          btns.forEach((b, n) => b.addEventListener("click", () => { show(n); held = true; tick(); }));
          roots.addEventListener("pointerenter", () => { held = true; tick(); });
          roots.addEventListener("pointerleave", () => { held = false; tick(); });
          new IntersectionObserver(([e]) => { seen = e.isIntersecting; tick(); }, { threshold: 0.4 }).observe(roots);
        }
        const io = new IntersectionObserver(([e]) => e.isIntersecting && (tree.classList.add("in"), io.disconnect()), { threshold: 0.3 });
        io.observe(tree);
      }
    </script>
  </section>

  <!-- ── BLOG ─────────────────────────────────────────── -->
