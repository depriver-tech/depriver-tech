  <!-- ── CONTACT ──────────────────────────────────────── -->
  <section id="contact" class="contact wrap">
    <div class="contact-card deep" data-reveal>
      <div class="c-left">
        <span class="label">Let's connect</span>
        <h2 class="display light">Let's build <span class="accent">something together</span></h2>
        <p class="c-lead">Have a project, an idea or just want to say hi? Pick the way that suits you.</p>
        <p class="clock" data-clock><i></i><span data-clock-text>Mbeya, Tanzania</span></p>
        <ul class="channels">
          {[
            { k: "wa", label: "WhatsApp", value: "Chat now", href: contact.whatsappHref, ext: true },
            { k: "phone", label: "Phone", value: contact.phone, href: contact.phoneHref, copy: contact.phone },
            { k: "mail", label: "Email", value: contact.email, href: contact.emailHref, copy: contact.email },
            { k: "in", label: "LinkedIn", value: contact.linkedin, href: contact.linkedinHref, ext: true },
            { k: "ig", label: "Instagram", value: contact.instagram, href: contact.instagramHref, ext: true },
            { k: "gh", label: "GitHub", value: contact.github, href: contact.githubHref, ext: true },
          ].map((c, i) => (
            <li class:list={["ch", c.k]} style={`--i:${i}`}>
              <a href={c.href} target={c.ext ? "_blank" : undefined} rel={c.ext ? "noopener" : undefined}>
                <span class="ch-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[c.k]} /></span>
                <span class="ch-txt"><em>{c.label}</em><strong>{c.value}</strong></span>
              </a>
              {c.copy && <button type="button" class="copy" data-copy={c.copy} aria-label={`Copy ${c.label.toLowerCase()}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                <span class="copied">Copied</span>
              </button>}
            </li>
          ))}
        </ul>
      </div>

      {/* the form as a chat: I say hi first, you reply */}
      <div class="chat">
        <div class="chat-head">
          <img src="/img/me-cut.webp" alt="" width="44" height="44" loading="lazy" />
          <span><strong>Privatus Cosmas</strong><em>Usually replies within a day</em></span>
        </div>
        <div class="chat-body">
          <p class="bubble">Habari! 👋</p>
          <p class="bubble">Tell me what you're building, what you need help with, or just say hi. I read every message.</p>
          <ContactForm />
        </div>
      </div>
    </div>
    <script>
      // copy buttons, and a live clock for Mbeya so you know if I'm likely awake
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => b.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy!); b.classList.add("done"); setTimeout(() => b.classList.remove("done"), 1600); } catch {}
      }));
      const tty = document.querySelector<HTMLElement>("[data-tty]");
      if (tty) {
        const io2 = new IntersectionObserver(([e]) => e.isIntersecting && (tty.classList.add("run"), io2.disconnect()), { threshold: 0.4 });
        io2.observe(tty);
      }
      const card = document.querySelector<HTMLElement>(".contact-card");
      if (card) {
        const io = new IntersectionObserver(([e]) => e.isIntersecting && (card.classList.add("talk"), io.disconnect()), { threshold: 0.35 });
        io.observe(card);
      }
      const clock = document.querySelector<HTMLElement>("[data-clock]");
      if (clock) {
        const text = clock.querySelector<HTMLElement>("[data-clock-text]")!;
        const tick = () => {
          const now = new Date();
          const time = now.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Africa/Dar_es_Salaam" });
          const h = +now.toLocaleString("en-GB", { hour: "numeric", hour12: false, timeZone: "Africa/Dar_es_Salaam" });
          const awake = h >= 7 && h < 23;
          clock.classList.toggle("awake", awake);
          text.textContent = `${time} in Mbeya · ${awake ? "I'm probably around" : "I'm asleep, I'll reply in the morning"}`;
        };
        tick();
        setInterval(tick, 30000);
      }
    </script>
  </section>
</Base>

