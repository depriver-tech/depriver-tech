---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Carousel from "../../components/Carousel.astro";
import Engage from "../../components/Engage.astro";
import Comments from "../../components/Comments.astro";
import PostDownload from "../../components/PostDownload.astro";
import { seriesOf } from "../../data/series";
import { livePosts, slidesFor, readingMinutes, formatDate, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await livePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { Content } = await render(post);
const slides = slidesFor(post.data.carousel);
const url = new URL(`/blog/${post.id}/`, Astro.site).toString();
// keep reading: same series first, then posts sharing the most tags, then the newest
const ser = seriesOf(post.data.tags);
const score = (p: Post) => (ser && p.data.tags.includes(ser.tag) ? 100 : 0) + p.data.tags.filter((t) => post.data.tags.includes(t)).length;
const more = posts.filter((p) => p.id !== post.id).map((p, i) => ({ p, s: score(p) * 1000 - i })).sort((a, b) => b.s - a.s).slice(0, 3).map((x) => x.p);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  image: new URL(`/og/blog/${post.id}.jpg`, Astro.site).toString(),
  url,
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  publisher: { "@id": "https://depriver.tech/#person" },
  author: { "@type": "Person", "@id": "https://depriver.tech/#person", name: "Privatus Cosmas", url: "https://depriver.tech/story/" },
  keywords: post.data.tags.join(", "),
};
---
<Base title={`${post.data.title} · Privatus Cosmas`} description={post.data.description} image={`/og/blog/${post.id}.jpg`}
  imageAlt={post.data.title} type="article" published={post.data.date} modified={post.data.updated} tags={post.data.tags}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {/* carousel posts: slides on one side, caption, stats and comments on the other, in one screen */}
  {slides.length > 0 ? (
    <article class="viewer wrap">
      <div class="v-media" data-reveal>
        <Carousel slides={slides} captions={post.data.slides} title={post.data.title} />
      </div>
      <aside class="v-panel" data-reveal data-lenis-prevent>
        <div class="v-top">
          <a class="v-author" href="/story/">
            <img src="/img/me-cut.webp" alt="" width="44" height="44" />
            <span><strong>Privatus Cosmas</strong><em>{formatDate(post.data.date, "long")} · {slides.length} slides</em></span>
          </a>
          <a class="v-back" href="/#posts" aria-label="All posts">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </a>
        </div>
        <div class="v-scroll">
          {ser && <a class="v-series" href="/#series">{ser.name}</a>}
          <h1 class="v-title">{post.data.title}</h1>
          <p class="v-desc" data-desc>{post.data.description}</p>
          <PostDownload slug={post.id} slideCount={slides.length} />
          <p class="v-step" data-step hidden><span data-step-n></span><button type="button" data-follow-toggle>Read everything</button></p>
          <div class="prose v-prose" data-clamp><Content /></div>
          <button class="v-more" type="button" data-more-text hidden>more</button>
          <p class="v-tags">{post.data.tags.map((t) => <span>#{t.replace(/\s+/g, "")}</span>)}</p>
          <Engage slug={post.id} title={post.data.title} url={url} />
          <Comments slug={post.id} compact />
        </div>
      </aside>
    </article>
  ) : (
    <article>
      <header class="wrap head">
        <a class="back" href="/#posts">← All posts</a>
        <p class="meta" data-reveal>
          {formatDate(post.data.date, "long")} · {readingMinutes(post)} min read
          {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </p>
        <h1 class="display" data-reveal>{post.data.title}</h1>
        <p class="desc" data-reveal>{post.data.description}</p>
        <PostDownload slug={post.id} />
        <div class="author" data-reveal>
          <img src="/img/me-cut.webp" alt="" width="48" height="48" />
          <div><strong>Privatus Cosmas</strong><span>Software Engineer & Digital Innovator</span></div>
        </div>
      </header>
      {post.data.cover && <img class="cover wrap" src={post.data.cover} alt="" data-reveal />}
      <div class="prose wrap" data-reveal><Content /></div>
      <div class="wrap engage-wrap"><Engage slug={post.id} title={post.data.title} url={url} /></div>
      <div class="wrap"><Comments slug={post.id} /></div>
    </article>
  )}

  {more.length > 0 && (
    <section class="wrap more">
      <span class="label">Keep reading</span>
      <div class="more-grid">{more.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}
</Base>

<script>
  // keep room under the scrolling text for the pinned comment box
  const panel = document.querySelector<HTMLElement>(".v-panel");
  const form = panel?.querySelector<HTMLElement>(".cm-form");
  // phones: long captions fold behind "more", like Instagram, so the comments stay close to the slides
  const text = document.querySelector<HTMLElement>("[data-clamp]");
  const moreBtn = document.querySelector<HTMLButtonElement>("[data-more-text]");

  // the text beside the slides follows them: each slide shows only the section written about it
  const cv = document.querySelector<HTMLElement>("[data-cv]");
  let following = false;
  if (text && cv) {
    // split at h2 headings, and at h3 too when that gets closer to one section per slide
    const captions: string[] = JSON.parse(cv.querySelector("[data-captions]")?.textContent || "[]");
    // numbered lists of bold-led points ("1. **Lesson.** ...") become one section per point
    text.querySelectorAll<HTMLOListElement>(":scope > ol").forEach((ol) => {
      const items = [...ol.children];
      if (items.length < 3 || !items.every((li) => li.firstElementChild?.tagName === "STRONG")) return;
      ol.replaceWith(...items.map((li, n) => {
        const one = document.createElement("ol");
        one.start = ol.start + n;
        one.dataset.item = n ? "next" : "first";
        one.append(li);
        return one;
      }));
    });
    const split = (sel: string) => {
      const out: HTMLElement[][] = [[]];
      [...text.children].forEach((el) => {
        if ((el.matches(sel) || (el as HTMLElement).dataset.item === "next") && out[out.length - 1].length) out.push([]);
        out[out.length - 1].push(el as HTMLElement);
      });
      return out;
    };
    const byH2 = split("h2"), byH3 = split("h2, h3");
    const parts = byH2.length < captions.length - 1 && byH3.length > byH2.length ? byH3 : byH2;
    if (parts.length > 2) {
      following = true;
      const stop = new Set(["the", "and", "for", "you", "your", "this", "that", "what", "how", "with", "are", "its", "they", "who", "why", "when", "from", "into", "not", "but", "can", "all", "one", "kwa", "really", "actually"]);
      const words = (s: string) => new Set(s.toLowerCase().replace(/[^a-z0-9 ]+/g, " ").split(/\s+/)
        .map((w) => (/^\d+$/.test(w) ? String(+w) : w)).filter((w) => (w.length > 2 || /^\d+$/.test(w)) && !stop.has(w)));
      const heads = parts.map((p) => words(p.map((el) =>
        el.matches("h2, h3") ? el.textContent : el.matches("ol[data-item]") ? el.querySelector("strong")?.textContent : "").join(" ")));
      // best in-order alignment of slides to sections: shared heading words, nudged toward the matching position
      const m = captions.length, k = parts.length;
      const fit = (i: number, n: number) => {
        const w = words(captions[i]);
        return [...w].filter((x) => heads[n].has(x)).length - 0.05 * Math.abs(n - (i * (k - 1)) / Math.max(1, m - 1));
      };
      const best: number[][] = [], from: number[][] = [];
      for (let i = 0; i < m; i++) {
        best[i] = []; from[i] = [];
        for (let n = 0; n < k; n++) {
          // the cover slide always opens on the intro, when the post has one
          let prev = !i && n > 0 && !parts[0][0].matches("h2, h3") ? -Infinity : 0, at = 0;
          if (i) { prev = -Infinity; for (let q = 0; q <= n; q++) if (best[i - 1][q] > prev) { prev = best[i - 1][q]; at = q; } }
          best[i][n] = prev + fit(i, n); from[i][n] = at;
        }
      }
      const map: number[] = [];
      let n = best[m - 1].indexOf(Math.max(...best[m - 1]));
      for (let i = m - 1; i >= 0; i--) { map[i] = n; n = from[i][n]; }
      const boxes = parts.map((p) => {
        const box = document.createElement("div");
        box.className = "v-part";
        p[0]?.before(box);
        box.append(...p);
        return box;
      });
      const desc = document.querySelector<HTMLElement>("[data-desc]")!;
      const step = document.querySelector<HTMLElement>("[data-step]")!;
      const stepN = step.querySelector<HTMLElement>("[data-step-n]")!;
      const toggle = step.querySelector<HTMLButtonElement>("[data-follow-toggle]")!;
      const scroller = document.querySelector<HTMLElement>(".v-scroll")!;
      const wide = matchMedia("(min-width: 901px)");
      const capLine = cv.querySelector<HTMLElement>("[data-caption]");
      let on = true, current = 0;
      step.hidden = false;
      const show = (i: number) => {
        current = i;
        stepN.textContent = `Slide ${i + 1} of ${captions.length}`;
        if (!on) return;
        const k = map[i] ?? 0;
        boxes.forEach((b, n) => {
          const was = !b.hidden;
          b.hidden = n !== k;
          if (!b.hidden && !was) b.animate([{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "none" }], { duration: 380, easing: "cubic-bezier(.2,.7,.2,1)" });
        });
        desc.hidden = k !== 0;
        if (capLine) capLine.hidden = true;
        if (wide.matches) scroller.scrollTo({ top: 0, behavior: "smooth" });
      };
      toggle.addEventListener("click", () => {
        on = !on;
        toggle.textContent = on ? "Read everything" : "Follow the slides";
        stepN.style.visibility = on ? "" : "hidden";
        if (on) show(current);
        else { boxes.forEach((b) => (b.hidden = false)); desc.hidden = false; if (capLine) capLine.hidden = false; }
      });
      cv.addEventListener("cv:slide", (e) => show((e as CustomEvent<number>).detail));
      show(0);
    }
  }
  if (!following && text && moreBtn && matchMedia("(max-width: 900px)").matches && text.scrollHeight > 260) {
    text.classList.add("clamped");
    moreBtn.hidden = false;
    moreBtn.addEventListener("click", () => { text.classList.remove("clamped"); moreBtn.hidden = true; });
  }
  if (panel && form) new ResizeObserver(() => panel.style.setProperty("--form-h", `${form.offsetHeight + 16}px`)).observe(form);
</script>

<style>
  .head { max-width: 820px; padding: 150px 0 40px; }
  .back { display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 14px; text-decoration: none; font-weight: 600; color: var(--accent); }
  .meta { color: var(--muted); font-weight: 500; margin: 0 0 16px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .tag { padding: 3px 12px; border-radius: 999px; background: var(--deep); color: var(--on-deep); font-size: 0.8rem; text-transform: capitalize; }
  h1 { font-size: clamp(2.2rem, 5.5vw, 4rem); }
  .desc { font-size: 1.2rem; color: var(--muted); margin: 20px 0 28px; }
  .author { display: flex; gap: 14px; align-items: center; }
  .author img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; object-position: top; background: var(--deep); filter: var(--photo-filter); }
  .author strong { display: block; color: var(--heading); }
  .author span { color: var(--muted); font-size: 0.9rem; }
  .cover { max-width: 1100px; border-radius: 32px; margin-bottom: 50px; aspect-ratio: 16 / 9; object-fit: cover; }
  .prose { max-width: 820px; padding-bottom: 40px; font-size: 1.15rem; line-height: 1.8; color: var(--text); }
  .prose :global(h2) { font-size: 1.8rem; color: var(--heading); line-height: 1.2; margin: 1.8em 0 0.6em; letter-spacing: -0.02em; }
  .prose :global(h3) { font-size: 1.35rem; color: var(--heading); margin: 1.6em 0 0.5em; }
  .prose :global(a) { color: var(--accent); font-weight: 500; }
  .prose :global(strong) { color: var(--heading); }
  .prose :global(blockquote) { margin: 1.6em 0; padding: 18px 24px; border-radius: 18px; border-left: 4px solid var(--accent); background: var(--surface-2); font-size: 1.05rem; color: var(--heading); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(img) { border-radius: 24px; margin: 1.6em 0; }
  .prose :global(pre) { background: var(--deep) !important; padding: 22px 24px; border-radius: 20px; overflow-x: auto; font-size: 0.95rem; line-height: 1.6; }
  .prose :global(:not(pre) > code) { background: var(--surface-2); color: var(--heading); padding: 2px 8px; border-radius: 6px; font-size: 0.92em; }
  .prose :global(li) { margin: 0.4em 0; }
  .prose :global(li::marker) { color: var(--accent); }
  .engage-wrap { max-width: 820px; padding-bottom: 60px; }
  .more { padding: 40px 0 120px; border-top: 1px solid var(--line); }
  .more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 30px; }

  /* VIEWER (carousel posts) */
  .viewer { --vh: calc(100svh - 112px); display: grid; grid-template-columns: auto minmax(340px, 1fr); gap: 22px; align-items: start; padding: 96px 0 30px; }
  .v-media { width: min(calc((var(--vh) - 118px) * 0.8), 62vw); }
  .v-media :global(.cv) { margin: 0; max-width: none; }
  .v-media :global(.cv-caption) { min-height: 0; font-size: 0.92rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .v-panel { position: relative; height: var(--vh); display: flex; flex-direction: column; border-radius: 26px; background: var(--surface); overflow: hidden;
    box-shadow: 0 1px 0 var(--line), 0 30px 60px -40px color-mix(in srgb, var(--shadow) 40%, transparent); }
  .v-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px 14px 18px; border-bottom: 1px solid var(--line); }
  .v-author { display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; min-width: 0; }
  .v-author img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: top; background: var(--deep); filter: var(--photo-filter); box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--accent); }
  .v-author strong { display: block; color: var(--heading); font-size: 0.95rem; }
  .v-author em { font-style: normal; color: var(--muted); font-size: 0.8rem; }
  .v-back { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; color: var(--heading); flex: none; }
  .v-back:hover { background: var(--surface-2); color: var(--accent); }
  .v-scroll { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 20px 22px var(--form-h, 180px); scrollbar-width: thin; }
  .v-series { display: inline-block; margin-bottom: 10px; padding: 4px 12px; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-size: 0.78rem; font-weight: 600; text-decoration: none; }
  .v-title { margin: 0; color: var(--heading); font-size: clamp(1.4rem, 2vw, 1.85rem); line-height: 1.2; letter-spacing: -0.02em; }
  .v-desc { margin: 10px 0 0; color: var(--muted); }
  .v-step { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 16px 0 0; padding-top: 12px; border-top: 1px solid var(--line); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .v-step[hidden] { display: none; }
  .v-step button { padding: 0; font: inherit; font-size: 0.78rem; letter-spacing: 0; text-transform: none; color: var(--muted); background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .v-step button:hover { color: var(--heading); }
  .v-prose :global(.v-part > h2:first-child) { margin-top: 0.6em; }
  .v-prose :global(ol[data-item]) { margin: 0.5em 0; }
  .v-prose { max-width: none; padding: 0; font-size: 1rem; line-height: 1.7; }
  .v-prose :global(h2) { font-size: 1.25rem; margin: 1.4em 0 0.4em; }
  .v-prose :global(h3) { font-size: 1.08rem; }
  .v-more { display: block; margin: -6px 0 16px; padding: 0; font: inherit; font-weight: 600; color: var(--heading); background: none; border: 0; cursor: pointer; }
  .v-tags { display: flex; flex-wrap: wrap; gap: 4px 10px; margin: 0 0 18px; font-size: 0.88rem; font-weight: 500; color: var(--accent); }
  .v-scroll :global(.eg) { box-shadow: none; padding: 0 0 16px; border-bottom: 1px solid var(--line); border-radius: 0; background: transparent; }
  @media (max-width: 900px) {
    .viewer { grid-template-columns: 1fr; padding-top: 90px; }
    .v-media { width: min(100%, 560px); margin: 0 auto; }
    .v-panel { position: static; height: auto; overflow: visible; }
    .v-scroll { overflow: visible; padding-bottom: 6px; }
    .v-scroll :global(.cm-form) { position: static; }
    .v-prose.clamped { max-height: 9.5em; overflow: hidden; -webkit-mask: linear-gradient(#000 55%, transparent); mask: linear-gradient(#000 55%, transparent); }
  }
  @media (max-width: 760px) { .viewer { padding-top: 124px; } }

  @media (max-width: 960px) { .more-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .more-grid { grid-template-columns: 1fr; } }
</style>
