---
import Base from '../../layouts/Base.astro';
import Title from '../../components/Title.astro';
import subjects from '../../data/subjects.json';
import '../../styles/study.css';
---
<Base title="Subject notes · Privatus Cosmas" description="Seven individual Computer Science foundation guides, with 56 numbered study sessions, worked examples and answers.">
  <div class="study wrap">
    <a class="study-back" href="/guides/">← All books and guides</a>
    <span class="label">The study room · Semester one</span>
    <Title tag="h1" title="One subject." accent="One clear session." size="clamp(2.8rem, 7vw, 5.8rem)" />
    <p class="study-lead">Choose a subject, work through its eight guided sessions, then test what you can explain without the notes. Every subject has its own printable book.</p>
    <div class="study-stats" aria-label="Library contents"><span><b>7</b> subjects</span><span><b>56</b> sessions</span><span><b>140</b> tasks + module questions</span></div>
    <div class="study-actions"><a class="btn" href="/guides/subjects/semester-one-subject-guides.zip" download>Download all subject guides <span aria-hidden="true">↓</span></a><a class="btn ghost" href="/guides/">Combined foundation book</a></div>
    <p class="study-scope">Independent foundation edition · 18 November 2026. These are proposed self-study sessions, not official lecture dates or complete current syllabuses. Align them with your lecturer’s outlines.</p>
    <section class="subject-grid" aria-label="Individual subjects">
      {subjects.map((subject, i) => <article class="subject-card" data-reveal>
        <div class="subject-top"><span class="subject-symbol" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h6a3 3 0 0 1 3 3v13a4 4 0 0 0-4-2H4V4Z"/><path d="M13 7a3 3 0 0 1 3-3h4v14h-3a4 4 0 0 0-4 2M7 8h3M7 12h3M16 8h1M16 12h1"/></svg></span><span>{String(i+1).padStart(2,'0')} / {subject.code}</span></div>
        <h2><a href={`/study/${subject.slug}/`}>{subject.title}</a></h2>
        <p>{subject.sessions[0].objective}</p>
        <div class="subject-meta"><span>8 sessions</span><span>{subject.pages}-page book</span></div>
        <a class="subject-open" href={`/study/${subject.slug}/`}>Explore subject <span aria-hidden="true">↗</span></a>
      </article>)}
    </section>
    <section class="study-method"><span class="label">A repeatable rhythm</span><h2>Read. Rebuild. Reason.</h2><p>Start with the objective. Follow the example, close the notes and attempt the independent task. Compare your reasoning with the worked answer, record the correction and return to it after a day and a week.</p><p>Suggested sessions take about 75 minutes, with room to slow down. A session number is a learning sequence, not a deadline.</p></section>
  </div>
</Base>
