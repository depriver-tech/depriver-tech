---
import Base from '../../layouts/Base.astro';
import {site} from '../../data/site';
import {statSync} from 'node:fs';
const size=statSync('public/archive/git-the-practical-notebook.pdf').size;
---
<Base title="Docs Archive · depriver.tech" description="A little library of useful things: handwritten lessons, documents, images, applications and ZIP downloads.">
  <main class="archive wrap" data-archive data-api={site.engageApi}>
    <div class="archive-heading"><span class="eyebrow">THE DEPRIVER NOTEBOOK / RESOURCE LIBRARY</span><h1>Good things.<br/><span>Worth keeping.</span></h1><p>Lessons to learn from. Files to build with.<br/>Find your next useful download in the Docs Archive.</p><a href="/docs/manage/" class="owner-link">Owner upload ↗</a></div>
    <section class="featured" aria-labelledby="featured-title"><div><span class="eyebrow">START HERE / HANDWRITTEN LESSON 001</span><h2 id="featured-title">Git, from the first commit.</h2><p>A practical notebook for learning Git: setup, branches, teamwork, recovery and two hands-on labs.</p><div class="file-meta">PDF · 22 pages · {(size/1024/1024).toFixed(1)} MB</div><a class="download" href="/archive/git-the-practical-notebook.pdf" download>Download the Git notebook ↓</a></div><div class="paper-sketch" aria-hidden="true"><span>Small changes.<br/>A clear history.</span><svg viewBox="0 0 280 120" fill="none"><path d="M20 80L250 80M85 80L145 25L210 25L250 80" stroke="currentColor" stroke-width="3"/><g fill="#fbf7ed" stroke="currentColor" stroke-width="3"><circle cx="25" cy="80" r="8"/><circle cx="85" cy="80" r="8"/><circle cx="145" cy="25" r="8"/><circle cx="210" cy="25" r="8"/><circle cx="250" cy="80" r="8"/></g></svg><small>edit → review → commit → share</small></div></section>
    <section aria-labelledby="library-title"><div class="library-heading"><h2 id="library-title">Browse the archive</h2><span id="archive-count" aria-live="polite">1 resource</span></div>
      <div class="filters"><label>Search files<input id="archive-search" type="search" placeholder="Search by title or filename…" /></label><label>File type<select id="archive-category"><option value="all">All files</option><option value="documents">Documents</option><option value="images">Images</option><option value="applications">Applications</option><option value="archives">ZIP & archives</option></select></label></div>
      <p id="archive-status" role="status"></p>
      <div class="file-grid" id="archive-list"><article class="file-card" data-category="documents" data-search="git practical notebook lesson pdf"><span class="file-label">PDF / DOCUMENT</span><h3>Git: the practical notebook</h3><p>22 pages of lessons, examples, practical exercises and an everyday command reference.</p><span class="file-meta">{(size/1024/1024).toFixed(1)} MB · 19 Oct 2026</span><a href="/archive/git-the-practical-notebook.pdf" download>Download PDF ↓</a></article></div>
      <p id="archive-empty" hidden>No files match your search. Try another word or file type.</p>
      <button id="archive-more" type="button" hidden>Load more files</button>
      <noscript><p>The Git lesson is available above. Enable JavaScript to browse newly uploaded files and use search.</p></noscript>
    </section>
  </main>
  <script>import '../../scripts/archive';</script>
</Base>
<style is:global>
@font-face{font-family:Notebook;src:url('/fonts/PatrickHand-Regular.ttf') format('truetype');font-display:swap}
.archive{padding-top:155px;padding-bottom:90px}.archive-heading{position:relative;margin-bottom:46px}.archive .eyebrow{font-size:.7rem;letter-spacing:.15em;font-weight:600;color:var(--muted)}.archive h1{font-family:Notebook,cursive;font-size:clamp(3.5rem,8vw,6.5rem);line-height:1.03;letter-spacing:-.02em;margin:20px 0}.archive h1 span{background:linear-gradient(transparent 75%,#f4d56e 75%,#f4d56e 90%,transparent 90%)}.archive-heading p{line-height:1.8;color:var(--muted)}.owner-link{display:inline-block;margin-top:14px;font-size:.85rem}.featured{display:grid;grid-template-columns:1.4fr 1fr;gap:35px;padding:36px 42px 38px 56px;background:repeating-linear-gradient(transparent 0px,transparent 31px,#cddde8 32px,#fbf7ed 33px),#fbf7ed;color:#183359;border-radius:9px;box-shadow:0 12px 35px #00000012;position:relative;margin-bottom:65px;border:1px solid #e5dcc8}.featured:before{content:'';position:absolute;left:30px;top:0;bottom:0;border-left:1px solid #cf8d8d}.featured .eyebrow{color:#536781}.featured h2{font-family:Notebook,cursive;color:#183359;font-size:2.6rem;line-height:1.1;margin:18px 0}.featured p{font-size:.95rem;line-height:1.8;max-width:500px}.file-meta{display:block;font-size:.78rem;color:var(--muted);margin:15px 0}.featured .file-meta{color:#536781}.download{display:inline-block;padding:12px 19px;background:#183359;color:#fff!important;text-decoration:none;border-radius:5px;margin-top:8px}.paper-sketch{align-self:center;transform:rotate(-3deg);color:#234f93}.paper-sketch span{font:2.3rem/1.2 Notebook,cursive}.paper-sketch svg{width:100%;max-width:300px}.paper-sketch small{font:1.25rem Notebook,cursive}.library-heading{display:flex;justify-content:space-between;align-items:center;gap:20px}.library-heading h2{font:2.7rem Notebook,cursive}.library-heading span{font-size:.8rem;color:var(--muted)}.filters{display:grid;grid-template-columns:1fr 220px;gap:20px;margin:25px 0}.filters label{font-size:.8rem;font-weight:500}.archive input,.archive select,.archive textarea{width:100%;padding:13px 14px;margin-top:8px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--heading);font:inherit}.archive :is(input,select,textarea,button,a):focus-visible{outline:3px solid var(--accent);outline-offset:3px}.file-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.file-card{padding:26px;border:1px solid var(--line);border-radius:8px;background:var(--surface);overflow-wrap:anywhere;display:flex;flex-direction:column}.file-label{font-size:.65rem;letter-spacing:.12em;color:var(--muted)}.file-card h3{font:1.8rem/1.15 Notebook,cursive;margin:18px 0 12px}.file-card p{font-size:.87rem;line-height:1.7}.file-card a{margin-top:auto;padding-top:12px;font-weight:600;font-size:.85rem}.archive button{padding:12px 18px;font:inherit;cursor:pointer;background:var(--heading);color:var(--bg);border:0;border-radius:5px}.archive button:disabled{opacity:.6;cursor:wait}.archive [hidden]{display:none!important}#archive-more{margin-top:25px}#archive-status{font-size:.85rem;color:var(--muted)}
@media(max-width:850px){.file-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.featured{gap:20px;padding-right:25px}.paper-sketch span{font-size:1.9rem}}
@media(max-width:600px){.archive{padding-top:155px}.featured{grid-template-columns:1fr;padding:28px 24px 30px 42px}.featured:before{left:22px}.paper-sketch{max-width:240px}.filters,.file-grid{grid-template-columns:1fr}.library-heading h2{font-size:2.1rem}.library-heading{align-items:baseline}.archive h1{font-size:3.6rem}}
</style>
